# Grey-box test fixture (not game art): exercises size, origin, hitbox,
# mirror = auto and a two-frame looping idle. The "eye" and "nose" sit on the
# right so mirrored copies are easy to spot.
sprite = test_box
size   = 16x24
origin = 8,24           # bottom centre
hitbox = 3,4,10,20
mirror = auto
anim   = idle frames=2 ticks=30 loop
