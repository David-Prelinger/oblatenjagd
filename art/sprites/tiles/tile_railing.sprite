# Love-lock railing, solid: lit handrail on top, mesh with padlocks.
# Autotiled (D-020): anim `auto`, frame = neighbour mask
# (1 = same tile above, 2 = right, 4 = below, 8 = left; level edge = same).
# Only the left/right bits change the look (end posts / end caps).
sprite = tile_railing
size   = 16x16
origin = 0,0
anim   = auto frames=16 ticks=1
