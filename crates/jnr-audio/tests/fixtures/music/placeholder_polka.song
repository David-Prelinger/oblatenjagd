# PLACEHOLDER (E57 test fixture; the sound-designer authors the real music).
# A 24-bar polka loop in B-flat with the Oblaten-Motiv as its pickup.
[meta]
id = "placeholder_polka"
kind = "loop"
tempo_bpm = 120
meter = "2/4"
steps_per_beat = 4            # sixteenths: a bar has 8 steps
key = "bb major"
bars = 24
order = ["A", "B", "A"]
source = "original"

[channels]
lead   = { instrument = "lead", volume_pct = 30 }
second = { instrument = "lead", volume_pct = 19 }
bass   = { instrument = "bass", volume_pct = 28 }
chords = { instrument = "chords", volume_pct = 28 }
drums  = { instrument = "drums", volume_pct = 12 }

[pattern.A]
score = '''
lead   | r/2 bb4 d5 f5 | eb5/4> d5      | c5/2 d5 eb5 c5 | bb4/4 a4       |
second | r/2 g4 bb4 d5 | c5/4 bb4       | a4/2 bb4 c5 a4 | g4/4 f4        |
bass   | bb2/4 f2      | bb2/4 f2       | f2/4 c3        | f2/4 c3        |
chords | r/2 [d4,f4,bb4]' r [d4,f4,bb4]' | r/2 [d4,f4,bb4]' r [d4,f4,bb4]' | r/2 [c4,f4,a4]' r [c4,f4,a4]' | r/2 [c4,f4,a4]' r [c4,f4,a4]' |
drums  | K/2 h K h     | K/2 h K h      | K/2 h K h      | K/2 h S h      |

lead   | r/2 bb4 d5 f5 | g5/4 f5        | eb5/2 d5 c5 a4 | bb4/4 _        |
second | r/2 g4 bb4 d5 | eb5/4 d5       | c5/2 bb4 a4 f4 | d4/8           |
bass   | bb2/4 f2      | eb2/4 bb2      | f2/4 c3        | bb2/4 f2       |
chords | r/2 [d4,f4,bb4]' r [d4,f4,bb4]' | r/2 [eb4,g4,bb4]' r [eb4,g4,bb4]' | r/2 [c4,f4,a4]' r [c4,f4,a4]' | r/2 [d4,f4,bb4]' r [d4,f4,bb4]' |
drums  | K/2 h K h     | K/2 h K h      | K/2 h K h      | K/2 S S S      |
'''

[pattern.B]
key = "f major"
score = '''
lead   | c5/4 a4       | f5/4 c5        | d5/2 c5 bb4 a4 | g4/8           |
second | a4/4 f4       | c5/4 a4        | bb4/2 a4 g4 f4 | e4/8           |
bass   | f2/4 c3       | f2/4 c3        | bb2/4 f2       | c3/4 g2        |
chords | r/2 [a3,c4,f4]' r [a3,c4,f4]' | r/2 [a3,c4,f4]' r [a3,c4,f4]' | r/2 [bb3,d4,f4]' r [bb3,d4,f4]' | r/2 [bb3,c4,e4]' r [bb3,c4,e4]' |
drums  | K/2 h S h     | K/2 h S h      | K/2 h S h      | K/2 h S h      |

lead   | c5/4 a4       | f5/4 e5        | g5/2 f5 e5 g5  | f5/4 eb5!      |
second | a4/4 f4       | c5/4 c5        | e5/2 d5 c5 e5  | c5/4 a4        |
bass   | f2/4 c3       | a2/4 c3        | c3/4 g2        | f2/4 f2        |
chords | r/2 [a3,c4,f4]' r [a3,c4,f4]' | r/2 [a3,c4,f4]' r [a3,c4,f4]' | r/2 [bb3,c4,e4]' r [bb3,c4,e4]' | r/2 [a3,c4,f4]' r [a3,c4,eb4!]' |
drums  | K/2 h S h     | K/2 h S h      | K/2 h S h      | [K,S]/2 S S S  |
'''

[[quote]]
fixture = "oblaten_motiv"
channel = "lead"
bar = 1
step = 2
