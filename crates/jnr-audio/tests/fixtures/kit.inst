# E55 test fixture for jnr-audio (not a game sound; the sound-designer authors those in audio/).
[kit]
K = "kick"
S = "snare"
h = "hihat"

[[patch.kick.layer]]
wave = "sine"
freq_hz = 120
slide_to_hz = 50
slide_ms = 60
attack_ms = 1
hold_ms = 20
decay_ms = 120
volume_pct = 70

[[patch.snare.layer]]
wave = "noise"
freq_hz = 20000
attack_ms = 1
decay_ms = 150
volume_pct = 45
bandpass = { hz = 1500, q_pct = 120 }

[[patch.snare.layer]]
wave = "sine"
freq_hz = 180
attack_ms = 1
decay_ms = 40
volume_pct = 30

[[patch.hihat.layer]]
wave = "noise"
freq_hz = 20000
attack_ms = 1
decay_ms = 40
volume_pct = 25
highpass_hz = 7000
