# The music box under water (audio-design §5 `unterwasser`): `spieluhr` through the
# piece's 1.2 kHz low-pass, with a shorter resonance (1.2 s, so the slow tune doesn't
# smear: S2b review note).
range = ["c3", "c7"]

[[layer]]
wave = "triangle"
attack_ms = 2
decay_ms = 600
sustain_pct = 0
release_ms = 20
volume_pct = 60
lowpass_hz = 1200

[[layer]]
wave = "sine"
detune_cents = 1200
attack_ms = 2
decay_ms = 600
sustain_pct = 0
release_ms = 20
volume_pct = 15
lowpass_hz = 1200

[[layer]]
wave = "sine"
attack_ms = 2
decay_ms = 1200
sustain_pct = 0
release_ms = 60
volume_pct = 16
lowpass_hz = 1200
