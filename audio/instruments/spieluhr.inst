# The music box of `ende` (audio-design §2.1): triangle plus a sine bell an octave up at
# -12 dB, A 2 / D 600 / S 0; and a quiet sine at the note ringing 2 s (the comb and the
# box resonating), so a held last note fades out instead of stopping dead.
range = ["c4", "c7"]

[[layer]]
wave = "triangle"
attack_ms = 2
decay_ms = 600
sustain_pct = 0
release_ms = 20
volume_pct = 60

[[layer]]
wave = "sine"
detune_cents = 1200
attack_ms = 2
decay_ms = 600
sustain_pct = 0
release_ms = 20
volume_pct = 15

[[layer]]
wave = "sine"
attack_ms = 2
decay_ms = 2000
sustain_pct = 0
release_ms = 60
volume_pct = 16
