# M1 in Brunnwinkl, the zither (audio-design §2.1): pulse 12 % (duty in whole percent),
# A 2 / D 400 / S 0 / R 200, two voices ±6 cents (the doubled strings; the second is
# the pulse upside down, 88 %). Low-passed at 2.2 kHz: the 12 % pulse is mostly a narrow
# spike, and the filter rounds it, so the quiet piece reaches the music bus RMS.
range = ["d3", "d6"]

[[layer]]
wave = "pulse"
duty_pct = 12
detune_cents = -6
attack_ms = 2
decay_ms = 400
sustain_pct = 0
release_ms = 200
volume_pct = 35
lowpass_hz = 2200

[[layer]]
wave = "pulse"
duty_pct = 88
detune_cents = 6
attack_ms = 2
decay_ms = 400
sustain_pct = 0
release_ms = 200
volume_pct = 35
lowpass_hz = 2200

# The zither's sympathetic strings: a quiet triangle at the note ringing 1.5 s, so the
# tune doesn't fall silent between plucks.
[[layer]]
wave = "triangle"
attack_ms = 5
decay_ms = 1500
sustain_pct = 0
release_ms = 200
volume_pct = 30
lowpass_hz = 2000
