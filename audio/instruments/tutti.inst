# The fortissimo chord of `boss_surprise` (audio-design §5, Haydn's „Paukenschlag"):
# pulse 25 %, A 2 / D 600 / S 0, every channel. Its partner `tutti_tief` is the same
# pulse upside down (duty 75 %), so the in-phase onsets of the four chord notes don't
# all stack in one direction.
range = ["g2", "c6"]

[[layer]]
wave = "pulse"
duty_pct = 25
attack_ms = 2
decay_ms = 600
sustain_pct = 0
release_ms = 20
volume_pct = 60
lowpass_hz = 4000
