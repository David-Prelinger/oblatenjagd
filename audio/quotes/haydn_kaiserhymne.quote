# Haydn, „Gott erhalte Franz den Kaiser" (Hob. XXVIa:43): the melody's first phrase
# („Gott erhalte Franz den Kaiser", 9 notes), F major as printed, 4/4 with a half-bar
# upbeat: F4 G4 | A4 G4 B-flat4 A4 | G4 E4 F4 (dotted quarter, eighth | quarters | eighth,
# eighth, quarter). Bad Ischl plays it at double note values in D; D-113's restriction:
# this phrase only, only in `bad_ischl`, no text. Grid: eighths.
source = "Joseph Haydn, Gott erhalte Franz den Kaiser, Hob. XXVIa:43, melody, first phrase (9 notes)"
edition = "Ludwig Erk (ed.), Die deutschen Volkslieder mit ihren Singweisen, Bd. 1 Heft 4, Berlin 1839, No. 43, pp. 49-50 (Wikimedia Commons)"
steps_per_beat = 2
notes = '''
f4/3 g4/1 | a4/2 g4 bb4 a4 | g4/1 e4 f4/2
'''
