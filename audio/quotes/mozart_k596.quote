# Mozart, Sehnsucht nach dem Frühlinge K. 596 („Komm, lieber Mai, und mache"): the voice
# part's first phrase, pickup + 4 bars to the first cadence („... wieder grün"), 6/8,
# F major. Grid: eighths. Bar 2's first C is tied over (dotted quarter + eighth). No text.
source = "W. A. Mozart, Sehnsucht nach dem Frühlinge K. 596, Singstimme, bars 0-4"
edition = "Mozarts Werke (AMA), Serie VII No. 37, ed. G. Nottebohm, Leipzig: Breitkopf & Härtel 1877, plate W.A.M. 596, p. 77 (IMSLP #63850)"
steps_per_beat = 1
notes = '''
f4/1 | f4/2 a4/1 c5/2 f5/1 | c5/3 _/1 a4/1 f4/1 | bb4/2 bb4/1 bb4/1 c5/1 bb4/1 | a4/3
'''
