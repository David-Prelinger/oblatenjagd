# „Summ, summ, summ" (traditional melody, „Volksweise"; Hoffmann von Fallersleben's text
# is not used): the first 8 bars of the voice part, 2/4, G major as printed.
# Grid: eighths.
source = "Traditional (Volksweise), Summ, summ, summ, first 8 bars"
edition = "Hoffmann von Fallersleben, Fünfzig Kinderlieder, Leipzig 1843, No. 43 „Biene“, p. 49 (GDZ Göttingen PPN362458375, via Wikimedia Commons)"
steps_per_beat = 2
notes = '''
d5/2 c5 | b4/2 r | a4/1 b4 c5 a4 | g4/2 r |
b4/1 c5 d5 b4 | a4 b4 c5 a4 | b4 c5 d5 b4 | a4 b4 c5 a4
'''
