# `strobl` „Durchfahrts-Polka" (audio-design §5): Stage 7, the town everybody only drives
# through. 2/4, 132 BPM (bar 0.909 s), B-flat major, Trio E-flat. Intro 2 + A 16 + B 8 +
# Trio 16 = 42 bars, 38.2 s. D-114: a loop plays from sample 0, so the honks come round
# each loop (bar 42's F7 leads into them).
# Intro (1-2): two car-horn honks as the pickup (A4 + C-sharp5 together: ♪, ♪ rest, ♪),
#   then a ♩ honk on beat 1 of bar 2.
# A (3-18): a busy polka of short repeated notes (traffic), full accompaniment.
# B (19-26) „Stop-and-go": one bar played, one bar silent except the indicator ticking
#   on every eighth; the music stops at the red lights.
# Trio (27-42): E-flat major, lighter (the old Ischlerbahn trackbed, now a cycle path):
#   a bicycle bell on the first beat of every 4-bar phrase, kick on 1 only.
[meta]
id = "strobl"
kind = "loop"
tempo_bpm = 132
meter = "2/4"
steps_per_beat = 4            # sixteenths: a bar has 8 steps
key = "bb major"
bars = 42
order = ["I", "A", "B", "T", "X"]
source = "original"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 27 }
second = { instrument = "tenorhorn", volume_pct = 19 }
bass   = { instrument = "helikon", volume_pct = 20 }
chords = { instrument = "begleitung", volume_pct = 20, arp_ms = 17 }
hupe   = { instrument = "hupe", volume_pct = 22, arp_ms = 0 }
drums  = { instrument = "schlagwerk", volume_pct = 8 }

[pattern.I]
score = '''
hupe   | r/2 [a4,c#5!]/2 r/2 [a4,c#5!]/2 | [a4,c#5!]/4 r/4 |
'''

