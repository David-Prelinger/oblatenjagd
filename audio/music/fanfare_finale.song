# `fanfare_finale` (audio-design §5): LevelComplete at the goal_stollen. 6/8, F major.
# Mozart's „Komm, lieber Mai" phrase (K. 596, pickup + 4 bars) with the full band, the
# Tenorhorn in sixths, the cymbal on every phrase start; then the 2-bar coda: the
# Oblaten-Motiv in augmentation (F5 A5 C6 quarter quarter quarter, B-flat5 half) and the
# Tusch: B-flat to F over a crescendo snare roll, ending on bass drum + choked cymbal.
# Bar 1 is the vamp that carries the pickup (as in `fanfare_clear`).
# Tempo: dotted quarter = 88 (tempo_bpm 264), not the design's 80: at 80 the 7 bars run
# 10.5 s, over the 10 s jingle limit; at 88 the cue is 9.6 s.
[meta]
id = "fanfare_finale"
kind = "jingle"
tempo_bpm = 264
meter = "6/8"
steps_per_beat = 2            # sixteenths: a 6/8 bar has 12 steps
key = "f major"
bars = 7
order = ["A"]
source = "W. A. Mozart, Sehnsucht nach dem Frühlinge K. 596, voice part, bars 0-4"
edition = "Mozarts Werke (AMA), Serie VII No. 37, ed. G. Nottebohm, Leipzig: Breitkopf & Härtel 1877, plate W.A.M. 596, p. 77 (IMSLP #63850)"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 36 }
second = { instrument = "tenorhorn", volume_pct = 26 }
bass   = { instrument = "helikon", volume_pct = 27 }
chords = { instrument = "begleitung", volume_pct = 20, arp_ms = 17 }
tusch  = { instrument = "orgel_satz", volume_pct = 11, arp_ms = 0 }
drums  = { instrument = "schlagwerk", volume_pct = 11 }

[pattern.A]
score = '''
lead   | r/10 f4/2          | f4/4 a4/2 c5/4 f5/2 | c5/6 _/2 a4/2 f4/2 | bb4/4 bb4/2 bb4/2 c5/2 bb4/2 |
second | r/10 a3/2          | a3/4 c4/2 a4/4 a4/2 | a4/6 _/2 c4/2 a3/2 | g4/4 g4/2 g4/2 e4/2 g4/2     |
bass   | f2/4 r/2 c3/4 r/2  | f2/4 r/2 c3/4 r/2   | f2/4 r/2 c3/4 r/2  | c3/4 r/2 g2/4 r/2            |
chords | r/4 [a3,c4,f4]'/2 r/4 [a3,c4,f4]'/2 | r/4 [a3,c4,f4]'/2 r/4 [a3,c4,f4]'/2 | r/4 [a3,c4,f4]'/2 r/4 [a3,c4,f4]'/2 | r/4 [bb3,c4,e4]'/2 r/4 [bb3,c4,e4]'/2 |
tusch  | r/12               | r/12                | r/12               | r/12                         |
drums  | K/6 K              | [K,B]/6 K           | K/6 K              | K/6 K                        |

lead   | a4/6 c5/2 bb4 g4   | f5/4 a5 c6          | bb5/8 f5/4         |
second | f4/6 e4/2 g4 e4    | a4/4 c5 f5          | d5/8 c5/4          |
bass   | f2/4 r/2 c3/4 r/2  | f2/4 r/2 c3/4 r/2   | bb1/8 f2/4         |
chords | r/4 [a3,c4,f4]'/2 r/4 [bb3,c4,e4]'/2 | r/4 [a3,c4,f4]'/2 r/4 [a3,c4,f4]'/2 | r/12 |
tusch  | r/12               | r/12                | [bb3,d4,f4]/8 [a3,c4,f4]/4 |
drums  | K/6 K              | [K,B]/6 K           | S/1@30 S@38 S@46 S@54 S@62 S@70 S@78 S@86 S@94 S@102 [K,C]/2 |
'''

[[quote]]
fixture = "mozart_k596"
channel = "lead"
bar = 1
step = 10

[[quote]]
fixture = "oblaten_motiv"
channel = "lead"
bar = 6
transpose = 7
augment = 4
