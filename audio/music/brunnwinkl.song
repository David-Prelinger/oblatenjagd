chords | r/2 [d4,f#4,a4]' [d4,f#4,a4]' | r/2 [c4,e4,g4]' [d4,f#4,a4]' | r/2 [b3,d4,g4]' [a3,c4,e4]' | r/2 [d4,f#4,c5]' [d4,f#4,c5]' |

