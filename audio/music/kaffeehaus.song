# `kaffeehaus` „Kaffeehaus-Walzer" (audio-design §5, ending Scene and Bill): 3/4, 132 BPM,
# E-flat major, A 16 + B 16 = 32 bars, loops from bar 1 (43.6 s).
# The title march recast as a salon waltz (the classic march-into-waltz variation):
# A is the march's A tune, down a fifth into E-flat, every 2/4 bar stretched into a 3/4
# bar (the Oblaten-Motiv opens it as ♪ ♪ ♪ ♩.); B is the march's Trio, in A-flat, as a
# slow waltz. Bar 32 is B-flat7 back into bar 1.
# Salon instrumentation as `cafe_zauner`: Stehgeiger, Klavier (a held second voice and
# the waltz's chords on 2 and 3), pizzicato bass on 1; no percussion except one cup
# clink in bar 1. Resi finally sits.
[meta]
id = "kaffeehaus"
kind = "loop"
tempo_bpm = 132
meter = "3/4"
steps_per_beat = 2            # eighths: a bar has 6 steps
key = "eb major"
bars = 32
order = ["A", "B", "X"]
source = "original"

[channels]
lead   = { instrument = "stehgeiger", volume_pct = 34 }
second = { instrument = "klavier", volume_pct = 20 }
bass   = { instrument = "pizzicato", volume_pct = 24 }
chords = { instrument = "klavier", volume_pct = 20, arp_ms = 17 }
drums  = { instrument = "salon", volume_pct = 12 }

# A (1-16): the march's A tune as a waltz, E-flat major.
