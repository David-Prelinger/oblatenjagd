# Bar 32: B-flat7, back into bar 1.
[pattern.X]
score = '''
lead   | bb4/2 ab4 f4  |
second | d4/6          |
bass   | bb1/2 r/4     |
chords | r/2 [bb3,d4,ab4]' [bb3,d4,ab4]' |
