# `game_over` „A schöne Leich'" (audio-design §5): a brass-band funeral march, the Viennese
# love of a beautiful funeral. 2/4, 60 BPM (bar 2 s), B-flat minor, 4 bars = 8 s, once.
# M1 the Oblaten-Motiv in minor and augmented (B-flat4 D-flat5 F5 E-flat5 as four
# quarters), M2 below it in thirds and sixths, the Helikon on every beat, sustained band
# chords, the muffled drum on every beat. Bar 3 sighs down to the dominant (F7), and the
# last chord turns major (the Picardy third, D natural): „Weiter?" is a hopeful question.
[meta]
id = "game_over"
kind = "jingle"
tempo_bpm = 60
meter = "2/4"
steps_per_beat = 2
key = "bb minor"
bars = 4
order = ["A"]
source = "original"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 27 }
second = { instrument = "tenorhorn", volume_pct = 20 }
bass   = { instrument = "helikon", volume_pct = 15 }
chords = { instrument = "orgel_satz", volume_pct = 26, arp_ms = 17 }  # held, as a chip chord: three in-phase voices overshoot the peak
drums  = { instrument = "schlagwerk", volume_pct = 9 }

[pattern.A]
score = '''
lead   | bb4/2 db5     | f5/2 eb5          | db5/2 c5          | d5!/4       |
second | f4/2 bb4      | db5/2 bb4         | bb4/2 a4          | bb4/4       |
bass   | bb1/2 f2      | bb1/2 eb2         | gb2/2 f2          | bb1/4       |
chords | [bb3,db4,f4]/4 | [bb3,db4,f4]/2 [eb4,gb4,bb4]/2 | [gb3,bb3,db4]/2 [f3,a3,eb4]/2 | [bb3,d4!,f4]/4 |
drums  | M/2 M         | M/2 M             | M/2 M             | M/2 r       |
'''

[[quote]]
fixture = "oblaten_motiv_moll"
channel = "lead"
bar = 1
compare = "pitches"     # four even quarters (§5), not a strict doubling of ♪♪♪♩
