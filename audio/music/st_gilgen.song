# `st_gilgen` „Platzkonzert-Polka" (audio-design §5): Stage 2. 2/4, 126 BPM (bar
# 0.952 s), E-flat major, Trio A-flat. Intro 4 + A 16 + Trio 16 + „Zugabe" 8 = 44 bars,
# 41.9 s. D-114: a loop plays from sample 0, so the count-in comes round each loop.
# Intro (1-4): the bandmaster counts in, four stick clicks (bars 1-2), then the band
#   swells on E-flat and B-flat7 over a snare roll (bars 3-4).
# A (5-20): the fullest Blasmusik of the game, every channel busy, the second voice in
#   thirds; from bar 13 the cymbal with every kick. Bar 20 is the Trio's pickup: the
#   Oblaten-Motiv in A-flat (A-flat4 C5 E-flat5 | D-flat5).
# Trio (21-36): A-flat major, cantabile, kick on 1 only.
# „Zugabe" (37-44): the Trio's last 8 bars again, a semitone higher (A major), the encore
#   nobody asked for; in bar 44 the Helikon slides back down A, A-flat, G, B-flat.
[meta]
id = "st_gilgen"
kind = "loop"
tempo_bpm = 126
meter = "2/4"
steps_per_beat = 4            # sixteenths: a bar has 8 steps
key = "eb major"
bars = 44
order = ["I", "A", "T", "Z"]
source = "original"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 26 }
second = { instrument = "tenorhorn", volume_pct = 20 }
bass   = { instrument = "helikon", volume_pct = 20 }
chords = { instrument = "begleitung", volume_pct = 19, arp_ms = 17 }
drums  = { instrument = "schlagwerk", volume_pct = 7 }

