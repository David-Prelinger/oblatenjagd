# `wolfgangsee` „Dampfer-Barcarole" (audio-design §5): Stage 6. 6/8, dotted quarter = 66
# (tempo_bpm counts eighths: 198; bar 1.818 s), F major. Intro 2 + A 16 + B 8 + A' 8 =
# 34 bars, 61.8 s (`unterwasser` renders to this length). D-114: a loop plays from
# sample 0, so the paddle wheel's intro comes round each loop.
# Intro (1-2): the paddle wheel alone: a soft chuff on 1 and 4, the Helikon rocking F-C.
# A (3-18): a lilting boat song on the clarinet (♩ ♪ ♩ ♪), the Tenorhorn below in held
#   sixths and thirds, Helikon on 1 and 4, Nachschlag on 3 and 6, the chuff quieter.
# B (19-26): the moving state border („Landesgrenze / wandert"): four bars in D minor,
#   then four in B-flat major, as if the boat crossed into another Land; C7 back to F.
# A' (27-34): A's second half, back in F.
[meta]
id = "wolfgangsee"
kind = "loop"
tempo_bpm = 198
meter = "6/8"
steps_per_beat = 2            # sixteenths: a 6/8 bar has 12 steps
key = "f major"
bars = 34
order = ["I", "A", "B1", "B2", "A2"]
source = "original"

[channels]
lead   = { instrument = "klarinette", volume_pct = 21 }
second = { instrument = "tenorhorn", volume_pct = 12 }
bass   = { instrument = "helikon", volume_pct = 14 }
chords = { instrument = "begleitung", volume_pct = 11, arp_ms = 17 }
drums  = { instrument = "schlagwerk", volume_pct = 7 }

[pattern.I]
score = '''
bass   | f2/4 r/2 c2/4 r/2 | f2/4 r/2 c2/4 r/2 |
drums  | H/6@100 H        | H/6@100 H        |
'''

