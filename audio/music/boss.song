chords | r/2 [c4,eb4,g4]' r [c4,eb4,g4]' | r/2 [g3,b3,f4]' r [g3,b3,f4]' | r/2 [g3,b3,f4]' r [g3,b3,f4]' | r/2 [g3,b3,d4]' r [g3,b3,d4]' |
