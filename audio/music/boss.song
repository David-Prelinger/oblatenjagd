# `boss` „Zahlen-bitte-Galopp" (audio-design §5): the fight with the Oberkellner. 2/4,
# 160 BPM (bar 0.75 s), C minor, B section in E-flat; loops from bar 1.
# A (1-8): driving; the Helikon's eighth-note ostinato on C-G, off-beat stabs, the lead's
#   rising „Vorsicht, heiß!" phrase, and in bar 8 the steam whistle sliding up a fifth.
# B (9-16) „Zahlen, bitte!": E-flat major; the lead adds up the bill (ta-ta-taa on one
#   note, a step higher every beat), the till's triangle on beat 1 of bars 12 and 16.
# A' (17-24): A again with the Oblaten-Motiv in minor (C5 E-flat5 G5 F5) in bar 23 and
#   G7 in bar 24.
# Then B once more (25-32), ending on G7 into bar 1. The design's A B A' is 24 bars =
# 18 s, under the music lint's 20 s floor for loops, so B comes round a second time:
# 32 bars = 24 s.
[meta]
id = "boss"
kind = "loop"
tempo_bpm = 160
meter = "2/4"
steps_per_beat = 4            # sixteenths: a bar has 8 steps
key = "c minor"
bars = 32
order = ["A", "B", "A2", "B"]
source = "original"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 23 }
second = { instrument = "tenorhorn", volume_pct = 17 }
bass   = { instrument = "helikon", volume_pct = 20 }
chords = { instrument = "begleitung", volume_pct = 17, arp_ms = 17 }
drums  = { instrument = "schlagwerk", volume_pct = 6 }
pfiff  = { instrument = "pfiff", volume_pct = 24 }

