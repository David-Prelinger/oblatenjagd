# Bars 33-34: the Tusch on B-flat.
[pattern.Z]
score = '''
lead   | f5/8          | bb5/2 r/6     |
second | d5/8          | f5/2 r/6      |
bass   | bb1/8         | bb1/2 r/6     |
drums  | S/1@30 S@40 S@50 S@60 S@70 S@80 S@90 S@100 | [K,B]/4 r/4 |
'''

[[quote]]
fixture = "oblaten_motiv"
channel = "trio"
bar = 1
