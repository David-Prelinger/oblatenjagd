# `falkenstein` „Pilgerweg" (audio-design §5): Stage 4. 3/4, 96 BPM (bar 1.875 s),
# D minor, B in F major. Intro 4 + A 16 + B 16 = 36 bars, 67.5 s. D-114: a loop plays
# from sample 0, so the prayer leader's call comes round each loop (bar 36's A7 leads
# into it).
# Intro (1-4): the prayer leader's call on one note: A4 A4 A4 | A4 A4 A4 | G4 | A4 over
#   the organ's held D minor.
# A (5-20): a slow procession hymn: the Flügelhorn climbs a step with every phrase (D4 to
#   D5, the path up the wall), the Tenorhorn a fifth under it (organum), the organ holds
#   the chords, the Helikon on 1, and the church bell strikes on beat 1 of bars 5, 9, 13
#   and 17.
# B (21-36): F major, the Hackelwurf: every 4 bars the lead leaps up a sixth (the throw)
#   and falls in a 4-note arc (the axe's flight); a yodel of octave flips in bars 29-32;
#   the Nachschlag back to um-pa-pa and clapping on 2 and 3; bar 36 on A7.
[meta]
id = "falkenstein"
kind = "loop"
tempo_bpm = 96
meter = "3/4"
steps_per_beat = 2            # eighths: a bar has 6 steps
key = "d minor"
bars = 36
order = ["I", "A", "B"]
source = "original"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 26 }
second = { instrument = "tenorhorn", volume_pct = 18 }
bass   = { instrument = "helikon", volume_pct = 20 }
orgel  = { instrument = "orgel_satz", volume_pct = 9, arp_ms = 0 }
chords = { instrument = "begleitung", volume_pct = 18, arp_ms = 17 }
drums  = { instrument = "schlagwerk", volume_pct = 10 }

[pattern.I]
score = '''
lead   | a4/2 a4 a4    | a4/2 a4 a4    | g4/6          | a4/6          |
orgel  | [d4,f4,a4]/6  | _/6           | _/6           | [c#4,e4,a4]/6 |
bass   | d2/6          | _/6           | _/6           | a1/6          |
'''

[pattern.A]
score = '''
lead   | d4/4 f4/2     | e4/4 g4/2     | f4/4 a4/2     | e4/6          |
second | g3/4 bb3/2    | a3/4 c4/2     | bb3/4 d4/2    | a3/6          |
bass   | d2/2 r/4      | c2/2 r/4      | f2/2 r/4      | a1/2 r/4      |
orgel  | [d4,f4]/6     | [c4,e4,g4]/6  | [c4,f4]/6     | [c#4,e4,a4]/6 |
drums  | G/6@40        | r/6           | r/6           | r/6           |

lead   | e4/4 g4/2     | f4/4 a4/2     | g4/4 bb4/2    | a4/6          |
second | a3/4 c4/2     | bb3/4 d4/2    | c4/4 d4/2     | a3/6          |
bass   | c2/2 r/4      | d2/2 r/4      | g2/2 r/4      | a1/2 r/4      |
orgel  | [c4,e4,g4]/6  | [d4,f4]/6     | [d4,g4,bb4]/6 | [c#4,e4,a4]/6 |
drums  | G/6@40        | r/6           | r/6           | r/6           |

lead   | f4/4 a4/2     | g4/4 bb4/2    | a4/4 c5/2     | bb4/6         |
second | bb3/4 d4/2    | c4/4 d4/2     | d4/4 f4/2     | d4/6          |
bass   | f2/2 r/4      | g2/2 r/4      | f2/2 r/4      | g2/2 r/4      |
orgel  | [c4,f4]/6     | [d4,g4,bb4]/6 | [c4,f4,a4]/6  | [d4,g4,bb4]/6 |
drums  | G/6@40        | r/6           | r/6           | r/6           |

lead   | g4/4 bb4/2    | a4/4 c5/2     | bb4/4 d5/2    | a4/6          |
second | c4/4 d4/2     | d4/4 f4/2     | d4/4 g4/2     | a3/6          |
bass   | g2/2 r/4      | f2/2 r/4      | g2/2 r/4      | a1/2 r/4      |
orgel  | [d4,g4,bb4]/6 | [c4,f4,a4]/6  | [d4,g4,bb4]/6 | [c#4,e4,a4]/6 |
drums  | G/6@40        | r/6           | r/6           | r/6           |
'''

[pattern.B]
key = "f major"
score = '''
lead   | c4/2 a4 bb4   | a4/2 g4 f4    | e4/2 g4 c5    | f4/6          |
bass   | f2/2 r/4      | f2/2 r/4      | c2/2 r/4      | f2/2 r/4      |
chords | r/2 [c4,f4,a4]' [bb3,d4,f4]' | r/2 [c4,f4,a4]' [c4,f4,a4]' | r/2 [c4,e4,bb4]' [c4,e4,bb4]' | r/2 [c4,f4,a4]' [c4,f4,a4]' |
drums  | r/2 X X       | r/2 X X       | r/2 X X       | r/2 X X       |

lead   | c4/2 a4 bb4   | a4/2 g4 f4    | g4/2 e4 c4    | f4/6          |
bass   | f2/2 r/4      | f2/2 r/4      | c2/2 r/4      | f2/2 r/4      |
chords | r/2 [c4,f4,a4]' [bb3,d4,f4]' | r/2 [c4,f4,a4]' [c4,f4,a4]' | r/2 [c4,e4,bb4]' [c4,e4,bb4]' | r/2 [c4,f4,a4]' [c4,f4,a4]' |
drums  | r/2 X X       | r/2 X X       | r/2 X X       | r/2 X X       |

lead   | f4/2 f5 c5    | e4/2 e5 c5    | d4/2 d5 bb4   | c4/2 c5 a4    |
bass   | f2/2 r/4      | c2/2 r/4      | bb1/2 r/4     | f2/2 r/4      |
chords | r/2 [c4,f4,a4]' [c4,f4,a4]' | r/2 [c4,e4,bb4]' [c4,e4,bb4]' | r/2 [bb3,d4,f4]' [bb3,d4,f4]' | r/2 [c4,f4,a4]' [c4,f4,a4]' |
drums  | r/2 X X       | r/2 X X       | r/2 X X       | r/2 X X       |

lead   | bb4/2 g4 e4   | a4/4 f4/2     | e4/2 g4 bb4   | a4/2 c#5! e5  |
bass   | c2/2 r/4      | f2/2 r/4      | c2/2 r/4      | a1/2 r/4      |
chords | r/2 [c4,e4,bb4]' [c4,e4,bb4]' | r/2 [c4,f4,a4]' [c4,f4,a4]' | r/2 [c4,e4,bb4]' [c4,e4,bb4]' | r/2 [c#4!,e4,g4]' [c#4!,e4,g4]' |
drums  | r/2 X X       | r/2 X X       | r/2 X X       | r/2 X X       |
'''
