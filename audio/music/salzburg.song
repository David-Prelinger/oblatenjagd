# `salzburg` „Mozart-Landler, eh klar" (audio-design §5): Stage 1. 3/4, 144 BPM (bar
# 1.25 s), B-flat major (the key of K. 606). Intro 2 + A 16 + B 16 + C 8 = 42 bars.
# D-114: a loop plays from sample 0, so the two um-pa-pa intro bars come round again after
# the C section (bar 42 lands on F, the dominant, and the vamp carries the pickup into A).
#
# A (3-18): Mozart, 6 Ländlerische Tänze K. 606, No. 1, the first strain (pickup + 8 bars,
#   repeated in the score) as printed for Violino I in the AMA, on the Flügelhorn in the
#   violin's octave. The Nachschlag takes its harmony from the AMA's Violino II (beat 2
#   B-flat, beat 3 F7 in bars 1 and 5 of the strain). Bars 3-10 as written; bars 11-18
#   the repeat with the Tenorhorn in thirds and sixths and the clapping on 2 and 3. The
#   pickup's A5 (Mozart's neighbour note) gets a bare D-F under it.
# B (19-34): original „Getreidegasse" strain in F: busy eighth-note runs (the crowd),
#   and in bars 27-28 the selfie stop: the Flügelhorn holds one note, the Nachschlag and
#   the drums drop out, and a triangle clicks the photo on beat 3 of bar 28.
# C (35-42): „Eine kleine Nachtmusik im Ländlertakt": K. 525, I., bars 1-4 of the first
#   violin, in B-flat, every 4/4 bar squeezed into one 3/4 bar (each note and rest becomes
#   an eighth, so the rocket limps), twice. Flügelhorn alone with the Helikon; bar 42
#   ends on F with a choked cymbal.
[meta]
id = "salzburg"
kind = "loop"
tempo_bpm = 144
meter = "3/4"
steps_per_beat = 2            # eighths: a bar has 6 steps
key = "bb major"
bars = 42
order = ["I", "A1", "A2", "B", "C"]
source = "W. A. Mozart, 6 Ländlerische Tänze K. 606 No. 1 (first strain); Eine kleine Nachtmusik K. 525, I. (bars 1-4)"
edition = "K. 606: Mozarts Werke (AMA) Serie 24 No. 16, Breitkopf & Härtel 1886 (IMSLP #24865); K. 525: autograph score, 1787 (IMSLP #562645)"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 28 }
second = { instrument = "tenorhorn", volume_pct = 19 }
bass   = { instrument = "helikon", volume_pct = 19 }
chords = { instrument = "begleitung", volume_pct = 30, arp_ms = 17 }
drums  = { instrument = "schlagwerk", volume_pct = 5 }

# Intro (1-2): um-pa-pa alone; the pickup to K. 606 in bar 2.
[pattern.I]
score = '''
lead   | r/6               | r/3 bb5/1 a5 bb5  |
bass   | bb2/2 r/4         | bb2/2 r/4         |
chords | r/2 [bb3,d4,f4]' [bb3,d4,f4]' | r/2 [bb3,d4,f4]' [d4,f4]' |
'''

# A, first time (3-10): K. 606 No. 1, the strain as written.
[pattern.A1]
score = '''
lead   | d6/1 bb5 f5 d5 eb5 c5 | g5 f5 d5 bb4 d5 bb4 | f5 eb5 c5 a4 c5 a4 | f5/3 bb5/1 a5 bb5 |
bass   | bb2/2 r/4         | bb2/2 r/4         | f2/2 r/4          | bb2/2 r/4         |
chords | r/2 [bb3,d4,f4]' [a3,c4,eb4]' | r/2 [bb3,d4,f4]' [bb3,d4,f4]' | r/2 [a3,c4,eb4]' [a3,c4,eb4]' | r/2 [bb3,d4,f4]' [d4,f4]' |
drums  | [K,B]/2 r/4       | K/2 r/4           | K/2 r/4           | K/2 r/4           |

lead   | d6/1 bb5 f5 d5 eb5 c5 | g5 f5 d5 bb4 d5 bb4 | f5 eb5 c5 a4 c5 a4 | bb4/3 bb5/1 a5 bb5 |
bass   | bb2/2 r/4         | bb2/2 r/4         | f2/2 r/4          | bb2/2 r/4         |
chords | r/2 [bb3,d4,f4]' [a3,c4,eb4]' | r/2 [bb3,d4,f4]' [bb3,d4,f4]' | r/2 [a3,c4,eb4]' [a3,c4,eb4]' | r/2 [bb3,d4,f4]' [d4,f4]' |
drums  | K/2 r/4           | K/2 r/4           | K/2 r/4           | K/2 S/1 S S S     |
'''

# A, the repeat (11-18): with the second voice and the clapping.
[pattern.A2]
score = '''
