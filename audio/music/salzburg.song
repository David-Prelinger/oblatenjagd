# C (35-42): K. 525 limping in 3/4, twice; Flügelhorn and Helikon alone, a choked cymbal
# on the last F.
[pattern.C]
score = '''
lead   | bb4/1@125 r f4@125 bb4@125 r f4@125 | bb4@125 f4@125 bb4@125 d5@125 f5@125 r | eb5@125 r c5@125 eb5@125 r c5@125 | eb5@125 c5@125 a4@125 c5@125 f4@125 r |
bass   | bb2/2 r/4         | bb2/2 r/4         | f2/2 r/4          | f2/2 r/4          |
drums  | r/6               | r/6               | r/6               | r/6               |

lead   | bb4/1@125 r f4@125 bb4@125 r f4@125 | bb4@125 f4@125 bb4@125 d5@125 f5@125 r | eb5@125 r c5@125 eb5@125 r c5@125 | eb5@125 c5@125 a4@125 c5@125 f4@125 r |
bass   | bb2/2 r/4         | bb2/2 r/4         | f2/2 r/4          | f2/2 r/4          |
drums  | r/6               | r/6               | r/6               | r/4 C/2           |
'''

[[quote]]
fixture = "mozart_k606_1"
channel = "lead"
bar = 2
step = 3

[[quote]]
fixture = "mozart_k606_1"
channel = "lead"
bar = 10
step = 3

[[quote]]
fixture = "mozart_k525_1"
channel = "lead"
bar = 35
transpose = -9
compare = "pitches"     # each 4/4 bar squeezed into one 3/4 bar: same notes and rests, shorter

[[quote]]
