# `boss_defeat` (audio-design §5): the third hit, a Tusch, the brass band's honour
# flourish. A held C major chord (Helikon C3, Tenorhorn E4, the Nachschlag rolling
# C4-E4-G4, Flügelhorn C5) over a snare roll (a stroke every 41.7 ms) swelling for
# 1 167 ms (the band holding back at 90 %), then the whole band re-strikes the chord,
# accented (from the bottom up, 42 ms apart, so the four onsets don't stack), with
# the bass drum and the cymbal; 1.5 s in all (3/4 at 120 BPM).
[meta]
id = "boss_defeat"
kind = "jingle"
tempo_bpm = 120
meter = "3/4"
steps_per_beat = 12           # 41.7 ms steps
key = "c major"
bars = 1
order = ["A"]
source = "original"

[channels]
lead   = { instrument = "fluegelhorn", volume_pct = 30 }
second = { instrument = "tenorhorn", volume_pct = 22 }
bass   = { instrument = "helikon", volume_pct = 16 }
chords = { instrument = "orgel_satz", volume_pct = 21, arp_ms = 17 }
drums  = { instrument = "schlagwerk", volume_pct = 27 }

[pattern.A]
score = '''
lead   | c5/30@90 c5/4> r/2 |
second | e4/29@90 e4/4> r/3 |
bass   | c3/28@90 c3/4> r/4 |
chords | [c4,e4,g4]/29@90 [c4,e4,g4]/4> r/3 |
drums  | S/1@40 S@44 S@47 S@51 S@54 S@58 S@61 S@65 S@68 S@72 S@75 S@79 S@82 S@86 S@89 S@93 S@96 S@100 S@103 S@107 S@110 S@114 S@117 S@121 S@124 S@128 S@131 S@135 [K,B]/8@80 |
'''
