# Resi jumps, „Hupf" (audio-design §6.2): pulse 25 % D4 -> A5, exponential over 120 ms.
# Player family: pulse 25 %, short hold, linear decay to zero.
[[layer]]
wave = "pulse"
duty_pct = 25
freq_hz = 294
slide_to_hz = 880
slide_ms = 120
attack_ms = 2
hold_ms = 8
decay_ms = 140
volume_pct = 35
lowpass_hz = 7000
