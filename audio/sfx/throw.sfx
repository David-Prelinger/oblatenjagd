# Hackl thrown, „Wusch" (audio-design §6.2): band-passed noise, centre 2.5 kHz -> 700 Hz,
# tremolo 25 Hz at 60 % depth (the spinning axe). 140 ms.
[[layer]]
wave = "noise"
freq_hz = 20000
bandpass = { hz = 2500, to_hz = 700, q_pct = 500 }
lowpass_hz = 4000
tremolo = { depth_pct = 60, rate_hz = 25 }
attack_ms = 10
hold_ms = 50
decay_ms = 80
volume_pct = 82
