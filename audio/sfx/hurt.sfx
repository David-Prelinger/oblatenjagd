# Hurt, „Schrumpf" (audio-design §6.2): pulse 50 % falling arpeggio G6 E6 C6 G5 E5 C5 G4,
# 70 ms each, every note bending down 50 cents (deflating). One layer per note so each
# note carries its own bend. 500 ms.
[[layer]]
wave = "pulse"
freq_hz = 1568
slide_to_hz = 1523
attack_ms = 1
hold_ms = 45
decay_ms = 24
volume_pct = 50
lowpass_hz = 7000

