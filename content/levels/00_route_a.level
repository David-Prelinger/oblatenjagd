# Test-only level (not part of the journey): stage 1 of the two-stage test
# route `route = route_a route_b` (tests/replays/flow_route_*.replay, D-047).
# On the route map it stands at Salzburg (stage i = station i). A Mozartkugel
# box at column 5 (4 tiles above the ground), two Oblaten at 8-9, a 2-tile
# wall at 14 (turns the Mozartkugel back), the goal at 24.

[meta]
id = "route_a"
time_limit = 30

[legend]
"#" = "solid"
"M" = { tile = "oblaten_box", contains = "mozartkugel" }
"o" = { entity = "oblate" }
"P" = { entity = "player_start" }
"G" = { entity = "goal" }

[map]
grid = '''
................................
................................
................................
................................
................................
................................
................................
.....M..........................
................................
........oo....#.................
..P...........#.........G.......
################################
'''
