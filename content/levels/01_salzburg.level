# Stage 1: Salzburg (docs/game-design.md "Stage 1: Salzburg").
# 264 columns x 17 rows; the street's top is row 15. The top 3 rows are
# headroom so the camera can rise above a high Maibaum touch (the „Wurstkranz!"
# popup stays below the HUD); the meadow after the rampart is one row lower,
# the lowest ground of the goal screen (D-029). Rows below are grid rows.
#   1 Busbahnhof        0-29   bus sign 4; 5 Oblaten 7-11 at walking height;
#                              B ? B at 14-16 (row 11, 4 above the street;
#                              right of the title subtitle); steps 18-19 (2)
#                              and 20-22 (3).
#   2 Mirabellgarten   30-79   sign 32; tourist #1 at 46 (activates after the
#                              start, meets Resi on flat ground ~37-44); B M at
#                              46-47 (row 11); hedge A 53-55 (6 right of the
#                              M-box, turns the Mozartkugel) with tourist #2;
#                              hedge planter 57-61 with a brick floor, Oblaten
#                              and tourist #3 (break in as Zuckerschock or jump
#                              in from the hedge); Pegasus fountain 65-70
#                              (basin 2, plinth 4, Oblaten arc); Zwergerlgarten
#                              dwarfs 72/74/77/79 with tourist #4 at 75. No pits.
#   3 Makartsteg       80-124  ground 80-82, sign 81, deck from 83; Salzach
#                              gaps 94-95 (2), 100-102 (3), 107-109 (3),
#                              118-121 (4); Taube #1 at head height over the
#                              deck (88), three more high up (105/114/123);
#                              raised solid railing 111-115 for the optional
#                              6-tile running jump to 122 (Oblaten arc 116-121).
#   4 Getreidegasse   125-179  sign 126, checkpoint 128, M-box 132 (row 11),
#                              house steps 136-137; Zunftschild Z1 138-140
#                              (row 11); Erker 144-148: stone box with Oblaten,
#                              the burger sign as its roof (row 8), reachable
#                              only by drop-through; Z3 152-154 (row 8), Z4
#                              157-159 (row 11); bench 142 keeps tourist pair A
#                              (138/141) out from under the Erker; pair B
#                              150/155; Geburtshaus sign 161, Verkaeufer #1 at
#                              165; stand 171-174 (roof row 12, 3 up) with
#                              Verkaeufer #2 and its sign.
#   5 Domplatz/Festung 180-263 Residenzbrunnen 190-194 (3 high), Fiaker 202;
#                              Dombogen arch 205-211 (passage 4 high); Jedermann
#                              stage 215-220 (2 high, sign 217) with a tourist;
#                              grandstand 223-228 (tiers 1/2/2) with two
#                              tourists; Kapitelplatz: sign 228, Sphaera 230-231
#                              + statue 231, chess pieces 235-236; Festungsbahn
#                              238-247: sign 237, the car waits at the top
#                              station (245, row 10) and rides to = [-7, 5] down
#                              to the station trench 238-242 (row 15 open, rock
#                              below; car top 8 px above the street); rock
#                              stairs 243-247 below the track (steps <= 2,
#                              D-027: always a way back up); rampart edge 248
#                              (top row 10, 5 above the street, 6 above the
#                              meadow) with a sitting Taube, a second Taube
#                              crossing at 251; Maibaum 252 on the meadow,
#                              Ortsende sign 255, level end 263 (D-029: wide
#                              enough that the camera still follows at the
#                              touch, so the Maibaum top sits in the HUD gap).

[meta]
id = "salzburg"
title_key = "stage.salzburg.title"
time_limit = 300
min_jump_window = 6
background = [
  { sprite = "bg_sky_salzburg", factor = 0 },
  { sprite = "bg_untersberg", factor = 3 },
  { sprite = "bg_festung", factor = 8 },
  { sprite = "bg_rooftops", factor = 13 },
]

[legend]
"#" = "ground"
"," = "meadow"
"R" = "rock"
"Q" = "rampart"
"h" = "hedge"
"S" = "stone"
"=" = "bridge"
"X" = "railing"
"|" = "railing_bg"
"~" = "salzach_water"
"w" = "salzach_water_deep"
"B" = "brick"
"A" = "arch"
"-" = "oneway_sign"
"_" = "oneway_burger"
"k" = "oneway_wood"
"?" = { tile = "oblaten_box", contains = "oblate" }
"M" = { tile = "oblaten_box", contains = "mozartkugel" }
"o" = { entity = "oblate" }
"t" = { entity = "selfie_tourist" }
"p" = { entity = "taube" }
"q" = { entity = "taube_sitting" }
"v" = { entity = "mozartkugel_verkaeufer" }
"f" = { entity = "fiaker" }
"F" = { entity = "festungsbahn", to = [-7, 5] }
"C" = { entity = "checkpoint" }
"P" = { entity = "player_start" }
"G" = { entity = "goal_maibaum" }
"b" = { entity = "sign", text = "stage.salzburg.sign_bus", style = "bus" }
"m" = { entity = "sign", text = "stage.salzburg.sign_mirabell" }
"l" = { entity = "sign", text = "stage.salzburg.sign_makartsteg" }
"c" = { entity = "sign", text = "stage.salzburg.sign_checkpoint", style = "bus" }
"g" = { entity = "sign", text = "stage.salzburg.sign_geburtshaus" }
"u" = { entity = "sign", text = "stage.salzburg.sign_stand" }
"j" = { entity = "sign", text = "stage.salzburg.sign_jedermann" }
"z" = { entity = "sign", text = "stage.salzburg.sign_sphaera" }
"e" = { entity = "sign", text = "stage.salzburg.sign_festungsbahn" }
"x" = { entity = "sign", text = "stage.salzburg.sign_ortsende", style = "ortsende" }

