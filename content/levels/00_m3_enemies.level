# Grey-box test level for the M3 enemies (M3 task E16; not part of the
# journey; side camera). Sections (columns): start 0-11; the Kreuzweg
# steps (1 tile at 12-15, 2 at 16-19, 3 at 20-31) with a pilgrim group
# (leader at 26, two more at 27-28) that walks left at activation and
# comes down the steps towards Resi; a Gams on a 1-tile block (38-42,
# Gams at 40: stand 60, crouch 16, hop 2 tiles, never leaves the block);
# an overhang (rows 0-5, 50-75) with two Steinschlag niches at row 5
# (bottom 6 tiles above the street): #1 at 56 over a one-way rockfall net
# (55-57, row 9: 3 tiles above the street, the shelter), #2 at 68 over the
# open street; goal at 84.
# Replays: tests/replays/m3_enemies_*.replay.

[meta]
id = "m3_enemies"
time_limit = 300

[legend]
"#" = "solid"
"-" = "oneway"
"L" = { entity = "pilger", lead = true }
"p" = { entity = "pilger" }
"a" = { entity = "gams" }
"r" = { entity = "steinschlag" }
"P" = { entity = "player_start" }
"G" = { entity = "goal" }

[map]
grid = '''
..................................................##########################..............
..................................................##########################..............
..................................................##########################..............
..................................................##########################..............
..................................................##########################..............
..................................................######r###########r#######..............
..........................................................................................
..........................................................................................
..........................Lpp.............................................................
....................############.......................---................................
................################........a.................................................
..P.........####################......#####.........................................G.....
##########################################################################################
##########################################################################################
'''
