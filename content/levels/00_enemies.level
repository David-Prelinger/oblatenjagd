# Grey-box test level for the enemies and the Festungsbahn (M1 task E3;
# not part of the journey). Sections (columns): start 0-4; a walking
# Selfie-Tourist from 16; a Mozartkugel box at 24 (row 8) with a 2-tile
# wall at 31 that turns the rolling Mozartkugel back; a
# Mozartkugel-Verkäufer at 40; a parked Fiaker at 58 on open ground; a
# flying Taube at 72 (row 7) and a sitting one at 80; the Festungsbahn
# from its bottom end in a 1-tile-deep pit (car at column 88, top 8 px
# below the 1-tile step at 83-86 it is boarded from) up [+8, -5] tiles to
# the rampart plateau (columns 99-107, top at row 7, 6 tiles above the
# pit floor). Stair-stepped rock under the track (D-027: falling off means
# waiting for the car or climbing back, never a softlock): column 93-94
# top row 12, 95 row 11, 96-97 row 10, 98 row 9, then the plateau (steps
# up of 1-2 tiles; `levels lint` checks <= 3), all below the car's path.
# Then a 6-tile drop to the meadow (floor row 13) with the goal at 114 on
# it, as low as the level allows: the base at screen y 164 puts the pole
# top (wreath) at y 36, but the 176 px Maibaum's tip still reaches into the
# HUD (y -12; it can't fit a 180 px screen, D-028).
# Replays: tests/replays/enemies_*.replay.

[meta]
id = "enemies"
time_limit = 300

[legend]
"#" = "solid"
"M" = { tile = "oblaten_box", contains = "mozartkugel" }
"t" = { entity = "selfie_tourist" }
"v" = { entity = "mozartkugel_verkaeufer" }
"f" = { entity = "fiaker" }
"u" = { entity = "taube" }
"s" = { entity = "taube_sitting" }
"F" = { entity = "festungsbahn", to = [8, -5] }
"P" = { entity = "player_start" }
"G" = { entity = "goal" }

[map]
grid = '''
........................................................................................................................
........................................................................................................................
........................................................................................................................
........................................................................................................................
........................................................................................................................
........................................................................................................................
........................................................................................................................
........................................................................u..........................#########............
........................M..........................................................................#########............
..................................................................................................##########............
...............................#................................................................############............
..P.............t..............#........v.................f.....................s..####........#############............
#######################################################################################.F....###############......G.....
########################################################################################################################
'''
