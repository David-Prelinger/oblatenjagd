# Grey-box test level for items, blocks and power states (not part of the journey).
# Sections (columns): start 0-4; Oblatenkiste (Oblate) 5, bricks 6-7 and a
# Mozartkugel box 8 (row 8, 4 tiles above the ground); a 2-tile wall at 16
# turns the rolling Mozartkugel back; Oblaten 19-23; an oblaten_10 brick at 26
# and a Zaunerstollen box at 28; a Selfie-Tourist (static for now) at 34 to get
# hurt by; checkpoint 38; a 2-tile Salzach pit 44-45; goal 60.
# Replays: tests/replays/items_*.replay.

[meta]
id = "items"
title_key = "stage.clear"
time_limit = 100

[legend]
"#" = "solid"
"~" = "salzach_water"
"B" = "brick"
"?" = { tile = "oblaten_box", contains = "oblate" }
"M" = { tile = "oblaten_box", contains = "mozartkugel" }
"Z" = { tile = "oblaten_box", contains = "zaunerstollen" }
"T" = { tile = "brick", contains = "oblaten_10" }
"o" = { entity = "oblate" }
"t" = { entity = "selfie_tourist" }
"C" = { entity = "checkpoint" }
"S" = { entity = "sign", text = "stage.salzburg.sign_bus", style = "bus" }
"s" = { entity = "sign", text = "stage.salzburg.sign_ortsende", style = "ortsende" }
"P" = { entity = "player_start" }
"G" = { entity = "goal" }

[map]
grid = '''
................................................................
................................................................
................................................................
................................................................
................................................................
................................................................
................................................................
................................................................
.....?BBM.................T.Z...................................
................................................................
................#...............................................
..P.......S.....#..ooooo..........t...C...........s.........G...
############################################~~##################
############################################~~##################
'''
