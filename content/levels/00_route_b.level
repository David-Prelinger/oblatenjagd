# Test-only level (not part of the journey): stage 2 of the two-stage test
# route `route = route_a route_b` (tests/replays/flow_route_*.replay, D-047).
# On the route map it stands at St. Gilgen; the next station (Brunnwinkl)
# has no level on that route, so clearing it plays the teaser. One Oblate at
# column 9, the goal at 24.

[meta]
id = "route_b"
time_limit = 30

[legend]
"#" = "solid"
"o" = { entity = "oblate" }
"P" = { entity = "player_start" }
"G" = { entity = "goal" }

[map]
grid = '''
................................
................................
................................
................................
................................
................................
................................
................................
................................
.........o......................
..P.....................G.......
################################
'''
