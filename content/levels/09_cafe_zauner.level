# Stage 9: Café Zauner (docs/game-design.md "Stage 9: Café Zauner", D-104
# ... D-108). 140 columns x 17 rows, side camera with camera_top 92 (the
# bottom clamp: the camera never moves vertically, D-104).
# Rows 0-6 are the stucco ceiling (stuck; only row 6's bottom 20 px show,
# behind the HUD), rows 7-14 the room, the marble floor's top is row 15
# (screen y 148). No pits, no lethal ground. Columns are 0-based.
#   1 Windfang & Garderobe 0-29: zauner_tuer (back) col 1, start 2, Bus
#        150? / Wurscht! (bus) 4, 5 Oblaten 7-11 on row 12 (the spec's row
#        13 at 6-10 sat on both sign boards, D-088), Sie werden / platziert
#        11, M-box 12 and ?-box 17 (row 11, 4 up; the spec's 14 and 16
#        stood in front of the back wall's mirror, bg x 215-264: the box
#        bottom met the mirror's bottom bar at screen 99-101, a shelf
#        illusion; 12 and 17 keep 7 px clear of its frame). Vitrine 18-19
#        (2 high): the Mozartkugel turns there. Pen 20-31 (walls 18-19 and
#        Vitrine A, 12 free tiles): Kellner #1 at 28, the hat shelf
#        oneway_wood 23-25 (row 12, 3 up) with the garderobe prop (back,
#        col 24) and 3 Oblaten on row 10; k.u.k. Hof- / zuckerbäcker at 21
#        (spec 24: the garderobe prop takes that cell; the board stands
#        beside the coat stand).
#   2 Salon 30-69: 1 Melange 31, Vitrine A 32-34, pen B 35-47 with
#        Kellner #2 at 44, L1 (luster, row 11, 4 up) 39-41 with 4 Oblaten
#        (row 9 39-41, row 8 40), Rezept 37, Bruch 45. Vitrine B 48-50 (3
#        Oblaten on its top), pen C 51-63: Kurgast 60, Selfie-Tourist 62,
#        L2 (row 10, 5 up) 56-58 with 3 Oblaten on row 8, ?-box (52, row
#        11) (spec 53: in front of the second mirror's frame, as above),
#        Kein Platz 52, Wartezeit 61 (D-110: was 80, behind Wartender
#        79). Vitrine C 64-66 (3 Oblaten on top).
#   3 Die Schlange 70-109: Abstand halten 68 (D-110: was 72, inside the
#        first Wartender's outline), Vitrine D 69-70 (3 high, 2 Oblaten
#        on top), nine Wartende at 73, 76, ..., 97 on marmor_punkt dots (3
#        apart: the chain works at walk speed), L3 74-78, L4 81-85, L5
#        88-92, L6 95-99 (row 10, 5 wide on the chain centres 76, 83, 90,
#        97, D-110; 2-tile gaps) with 3 Oblaten each on row 9 over the
#        centres and 2 on row 8 over each gap (79-80, 86-87, 93-94); no
#        board in the queue. Vordrängeln 101, ?-box (108, row 11) (spec
#        105: in front of the window's sill) over the Oblaten 107-111 (row
#        12: on row 13 they sat on the board at 109), Erst essen, / dann
#        posten 109 (D-110: was 61).
#   4 Vor der Theke 110-119: checkpoint 112, Reserviert / seit 1832
#        (street) 115, M-box (115, row 11) (spec 117: E46's 2 px band for
#        a big Resi under the box onto the step; at 116 the Mozartkugel
#        landed on the step and turned at the arena's vitrine instead), a
#        1-high marble step 118-119. The Mozartkugel lands on the floor at
#        117 and turns at the step's face (replay
#        cafe_zauner_mozartkugel_step).
#   5 Die Kuchentheke 120-139 (the arena, D-106): Tortenvitrine 120-121
#        and the counter (theke) 137-139, both 3 high; floor 122-136;
#        Oberkellner at 134; goal_stollen (138, row 11) on the counter;
#        kuchentheke (back) from cell (136, 14) dx 32 (centred on col 138:
#        the catalog's cell 138 is the solid counter). The arena locks at
#        camera x 1920.
# luster_deko (back, row 8, dx 8) on the background's free chain columns
# 10, 36, 50, 123, 130 (x mod 640 = 168, 584, 168, 56, 168); L1-L6 on
# the planned columns (D-104 art exception 2).
# Oblaten: 46 placed + 3 in ?-boxes = 49 (target 50 +- 10).
# time_limit 200 provisional (D-045: QA's relaxed run sets it).
# Solver (with the boss, E46 ranking; re-solved for D-110): complete 2278,
# 15 jumps, narrowest counted window 12 (frame 388, x 969: from pen C's
# floor over Vitrine C onto Vitrine D), the others 14+ (route-bounded)
# and 21-25; gate min_jump_window = 5 (the 6-9 target is withdrawn,
# D-110). Named timings (the D-104 and D-110 addenda have the full list):
# Kellner #1 walks from the first frame and reaches the vitrine's face
# (x 320) at frame ~128: the solver drops off the vitrine onto his tray
# at 129 („Komm' gleich!"). The queue: the solver bounces over 6 heads at
# run speed (no counted press; release windows 13 / 15 / 13 / 25 by the
# D-100 shift); one at a time (queue_walk) 6-11 per press, 10-50 per hop;
# the nine-head chain 5-8 (optional, the 1-up); the chandelier route at
# walk speed 10 / 13 / 13 / 12 (big 10 / 8 / 7 / 8). The arena: the solver
# jumps over the step and the vitrine at 740 (window 25), the lock is
# 824, hits 1283 / 1792 / 2250.
# Replays: tests/replays/cafe_zauner_*.replay.

[meta]
id = "cafe_zauner"
title_key = "stage.cafe_zauner.title"
time_limit = 200
min_jump_window = 5
camera_top = 92
background = [
  { sprite = "bg_zauner_salon", factor = 16 },
]

[legend]
"#" = "stuck"
"=" = "marmor"
":" = "marmor_punkt"
"V" = "vitrine"
"T" = "theke"
"-" = "luster"
"+" = "oneway_wood"
"?" = { tile = "oblaten_box", contains = "oblate" }
"M" = { tile = "oblaten_box", contains = "mozartkugel" }
"o" = { entity = "oblate" }
"P" = { entity = "player_start" }
"C" = { entity = "checkpoint" }
"G" = { entity = "goal_stollen" }
"k" = { entity = "kellner" }
"u" = { entity = "kurgast" }
"t" = { entity = "selfie_tourist" }
"w" = { entity = "wartender" }
"K" = { entity = "oberkellner" }
"1" = { entity = "prop", sprite = "zauner_tuer", layer = "back" }
"2" = { entity = "prop", sprite = "garderobe", layer = "back" }
"3" = { entity = "prop", sprite = "kuchentheke", dx = 32, layer = "back" }
"4" = { entity = "prop", sprite = "luster_deko", dx = 8, layer = "back" }
"a" = { entity = "sign", text = "stage.cafe_zauner.sign_bus", style = "bus" }
"b" = { entity = "sign", text = "stage.cafe_zauner.sign_platziert" }
"c" = { entity = "sign", text = "stage.cafe_zauner.sign_hofzucker" }
"d" = { entity = "sign", text = "stage.cafe_zauner.sign_melange" }
"e" = { entity = "sign", text = "stage.cafe_zauner.sign_rezept" }
"f" = { entity = "sign", text = "stage.cafe_zauner.sign_bruch" }
"g" = { entity = "sign", text = "stage.cafe_zauner.sign_liegen" }
"h" = { entity = "sign", text = "stage.cafe_zauner.sign_posten" }
"i" = { entity = "sign", text = "stage.cafe_zauner.sign_abstand" }
"j" = { entity = "sign", text = "stage.cafe_zauner.sign_wartezeit" }
"l" = { entity = "sign", text = "stage.cafe_zauner.sign_vordraengeln" }
"n" = { entity = "sign", text = "stage.cafe_zauner.sign_checkpoint" }

[map]
grid = '''
############################################################################################################################################
############################################################################################################################################
############################################################################################################################################
############################################################################################################################################
############################################################################################################################################
############################################################################################################################################
############################################################################################################################################
............................................................................................................................................
..........4.........................4...o.........4.....ooo....................oo.....oo.....oo............................4......4.........
.......................................ooo.................................ooo....ooo....ooo....ooo.........................................
.......................ooo..............................---...............-----..-----..-----..-----........................................
............M....?.....................---..........?................oo.....................................?......M......................G.
.......ooooo...........+++......................ooo.............ooo..VV....................................ooooo........VV...............TTT
..................VV............VVV.............VVV.............VVV..VV.................................................VV...............TTT
.1P.a......b......VV.c..2...k..dVVV..e......kf..VVV.g.......ujt.VVV.iVV..w..w..w..w..w..w..w..w..w...l.......h..C..n..==VV............K.3TTT
=========================================================================:==:==:==:==:==:==:==:==:==========================================
============================================================================================================================================
'''
