# Stage 4: Falkenstein (docs/game-design.md "Stage 4: Falkenstein").
# 240 columns x 42 rows, climb camera (D-053/D-054). Fürberg's path is row
# 40 (rows 40-41, the level bottom); the stage climbs to the church plateau
# (row 11) and ends on the goal meadow (row 16), whose rows 0-16 copy the
# Stage 1-3 goal layout. Under every walking surface kalkfels runs down to
# the level bottom, except in the two clefts (111-113 and 207-209).
#   1 Fürberg          0-27   jetty 0-4 (start col 2), shore path row 40.
#                             Bus 150 / nur z'Fuß sign 5; Gasthof Fürberg
#                             (back, cell 12 + dx -56: house 5-11, beer
#                             garden 10-13, so the B M B row at 12-14 / row
#                             36 is clear of its upper windows); 5 Oblaten
#                             7-11; M-box 13 (row 36, 4 up) between bricks;
#                             garden wall (stone) 16, 2 high, turns the
#                             Mozartkugel; Weg 28 sign 20; Pilger #1 at 26
#                             on flat ground (paces 17-27 between the wall
#                             and the first step).
#   2 Kreuzweg        28-79   forest_path steps on kalkfels: 39 (28-33),
#                             38 (34-38), 36 (39-45), 34 (46-64): the first
#                             steps are 1, 1, 2, 2 tiles. Steinhaufen +
#                             „Bitte Stein" sign 29-32, bildstock 36, 56,
#                             67. „Pilgerstau" sign 44 on the terrace below
#                             the long terrace 46-64 (2 higher); pilger
#                             group A (lead 57, 58, 59) walks left along it
#                             and down the steps; ?-box 42 (row 32).
#                             Holzstiege: steig planks row 31 (57-61) and
#                             row 28 (60-64), 3 and 6 above the terrace,
#                             overlapping by 2, onto the top terrace 65-69
#                             (row 28; its face is 6 high). Trough 70-79
#                             (row 29, 1 down) with pair B (74, 75) and the
#                             single #7 (78): the walls at 69 and 80 keep
#                             them in it (stomp them from the terrace edge
#                             or hop over).
#   3 Steinschlag     80-119  path row 28, the overhang's underside row 21
#                             (niche bottoms 6 tiles above the path). Sign
#                             81; rock #1 at 88 (range 9) over the net 86-90
#                             (row 25, posts 86/90); rock #2 at 92;
#                             Gamswild sign 94; Gams #1 on the shelf 95-99
#                             (row 24, 3 tiles of headroom under it, 4 of
#                             air above it; the tongue at 100 and the
#                             shelf's left end turn it); step up 2 at 103
#                             (101-102 under open overhang, so it can be
#                             jumped); rocks #3 105 and #4 107 (period 150,
#                             phases 0/75) over path row 26 (4 tiles); the
#                             overhang rises to row 16 from 108, so the
#                             cleft 110-112 (3 wide, bottomless, flat row
#                             26 both sides, no rock column within 2 tiles)
#                             is a free walking jump. Checkpoint 114, curb
#                             115 (1 high), M-box 117 (row 22, 3 columns
#                             after the checkpoint), Bus 150 / winzig, voll
#                             sign 119 (D-039). The Mozartkugel rolls
#                             between the curb and the shaft's right wall.
#   4 Falkensteinwand 120-131 left wall 120 (rows 0-20, entrance rows 21-25:
#                             the first plank jump is made in the open),
#                             right wall 130-131 (row 11 down), inner 121-
#                             129 (9) with the kalkfels_bg back wall from
#                             row 12 (not above the plateau). steig_wall
#                             planks row 23 (121-125), 20 (125-129), 17
#                             (121-125), 14 (125-129), then 3 up onto the
#                             plateau at 130. Pilger #8 starts on the top
#                             plank and zigzags down (the walls turn him).
#                             12 Oblaten, 3 above each plank.
#   5 Falkensteinkirche 130-169 plateau row 11 under the wall (rows 0-3,
#                             133-163). Church 134-139 (back, its top meets
#                             the wall's underside), steinhaufen 140-141,
#                             Brunnkapelle 142-144, „Passt jeder" sign 146,
#                             Durchkriechstein 150-153 (prop over invisible
#                             rows 8-9, tunnel row 10, mouth 149, exit 154;
#                             the route climbs over it, 3 up and 3 down;
#                             the durchkriechstein entity in (150, 10)).
#                             Einsiedelei: a bulge of the wall (157-163,
#                             rows 4-7) with a cave 159-161 (rows 3-6, back
#                             wall) over a steig_wall floor (row 7, one-way,
#                             4 above the plateau: an optional held jump up
#                             through it); Z-box 160 row 4 hangs in the
#                             cave with air above it (the item rises into
#                             row 3), the cave walls stop the Zaunerstollen.
#                             „Einsiedelei" sign 160 (under the cave,
#                             clear of the stone exit's popups). No enemies.
#   6 Sattel/Maibaum  170-239 one step down (row 12) from the plateau, so
#                             nothing walks back to the church. Hacklwurf
#                             sign 167 (on the plateau), hackelwurfkapelle 173 with a
#                             taube_sitting on Wolfgang's head (173, row 9,
#                             dy -4: perched right above the mitre tip).
#                             H-box at the plateau's end (166, row 7, 4
#                             up; the Hackl stays on it), so the stretch
#                             170-194 is a clear axe lane with no box over
#                             it; pilger group C 191-193 (lead 191) walks
#                             left over it from 15+ tiles away.
#                             Saddle: dip 195-200 (row 13, Gams #2 at 198),
#                             take-off 201-206 (row 12), cleft 207-209,
#                             landing 210-215 (row 12), dip 216-220 (row
#                             13, Gams #3 at 218), 221-222 (row 11),
#                             Aberseeblick 223-226 (row 10, 6 above the
#                             meadow); meadow row 16 from 227, Maibaum 230,
#                             Ortsende 233.
# Replays: tests/replays/falkenstein_*.replay.

[meta]
id = "falkenstein"
title_key = "stage.falkenstein.title"
time_limit = 255
camera = "climb"
min_jump_window = 5
background = [
  { sprite = "bg_sky_salzburg", factor = 0 },
  { sprite = "bg_wolfgangsee_tief", factor = 8, y = 32, factor_y = 3 },
  { sprite = "bg_falkenstein", factor = 13, factor_y = 8 },
]

[legend]
"#" = "kalkfels"
"=" = "forest_path"
":" = "kalkfels_bg"
"-" = "steig"
"w" = "steig_wall"
"n" = "netz"
"|" = "netz_post"
"j" = "jetty"
"J" = "jetty_post"
"~" = "wolfgangsee_water"
"K" = "stone"
"," = "meadow"
"B" = "brick"
"I" = "invisible"
"?" = { tile = "oblaten_box", contains = "oblate" }
"M" = { tile = "oblaten_box", contains = "mozartkugel" }
"Z" = { tile = "oblaten_box", contains = "zaunerstollen" }
"H" = { tile = "oblaten_box", contains = "hackl" }
"D" = { entity = "durchkriechstein", len = 4 }
"o" = { entity = "oblate" }
"0" = { entity = "oblate", tile = "kalkfels_bg" }
"P" = { entity = "player_start" }
"C" = { entity = "checkpoint" }
"G" = { entity = "goal_maibaum" }
"L" = { entity = "pilger", lead = true }
"p" = { entity = "pilger" }
"8" = { entity = "pilger", tile = "kalkfels_bg" }
"g" = { entity = "gams" }
"r" = { entity = "steinschlag", range = 9 }
"s" = { entity = "steinschlag", period = 150 }
"t" = { entity = "steinschlag", period = 150, phase = 0 }
"u" = { entity = "steinschlag", period = 150, phase = 75 }
"q" = { entity = "taube_sitting", dy = -4 }   # bottom row right above the mitre tip
"1" = { entity = "prop", sprite = "gasthof_fuerberg", dx = -56, layer = "back" }
"2" = { entity = "prop", sprite = "bildstock", layer = "back" }
"3" = { entity = "prop", sprite = "steinhaufen", dx = 8 }
"4" = { entity = "prop", sprite = "falkensteinkirche", dx = 8, layer = "back" }
"5" = { entity = "prop", sprite = "brunnkapelle", dx = 8, layer = "back" }
"6" = { entity = "prop", sprite = "hackelwurfkapelle", layer = "back" }
"7" = { entity = "prop", sprite = "durchkriechstein", dx = 8, layer = "back" }
"b" = { entity = "sign", text = "stage.falkenstein.sign_bus", style = "bus" }
"x" = { entity = "sign", text = "stage.falkenstein.sign_weg" }
"y" = { entity = "sign", text = "stage.falkenstein.sign_steine" }
"z" = { entity = "sign", text = "stage.falkenstein.sign_pilgerstau" }
"S" = { entity = "sign", text = "stage.falkenstein.sign_steinschlag" }
"A" = { entity = "sign", text = "stage.falkenstein.sign_gams" }
"c" = { entity = "sign", text = "stage.falkenstein.sign_checkpoint", style = "bus" }
"d" = { entity = "sign", text = "stage.falkenstein.sign_durchkriech" }
"e" = { entity = "sign", text = "stage.falkenstein.sign_einsiedelei" }
"h" = { entity = "sign", text = "stage.falkenstein.sign_hackl" }
"O" = { entity = "sign", text = "stage.falkenstein.sign_ortsende", style = "ortsende" }

