# Grey-box test level for the auto-scroll camera (M5 task E26, D-075; not
# part of the journey). 112 x 17, decks on row 11, water rows 12-15, lake
# bed on row 16 as in Stage 6. `autoscroll = [8, 80]`: the scroll starts
# when Resi's centre passes column 17 (camera x 128) and ends at camera x
# 1280 (1152 px at 0.75 px/frame: 1536 frames); the goal at column 104 is
# past to + 20 = 100. Sections (columns): start quay 0-24 (solid) -> a
# 3-column water gap -> one-way pier 28-43 -> a 3-wide island 44-46 whose
# top (row 8) is 3 tiles above the pier: the squeeze test wall (an idle
# player in front of it is squeezed; a jump gets onto it) -> pier 47-53
# with a solid pier head at 54 (deck to lake bed, E31: so the dry basin's
# floor is no raised step in the lake bed a diver could be squeezed
# against, D-085) -> shallows 55-66 (floor row 14, 3 tiles below the decks) with a Gondel
# going 8 tiles left (64 -> 56): the carry past the left edge -> pier
# 67-79 with the checkpoint at 72 (its respawn is framed inside the zone:
# the 60-frame hold) -> a 3-column gap -> the lead-out quay 83-111.
# The water is swim water (`see_wasser`, D-076; E30), so "pushed into the
# water" ends swimming, not in a death. Only the gap 80-82 is the lethal
# `wolfgangsee_water`: a test pit for the checkpoint respawn in the zone
# (Stage 6 itself has no lethal pit, D-074).
# Replays: tests/replays/m5_autoscroll_*.replay.

[meta]
id = "m5_autoscroll"
time_limit = 200
camera = "autoscroll"
autoscroll = [8, 80]
min_jump_window = 5

[legend]
"#" = "solid"
"-" = "oneway"
"~" = "see_wasser"
"x" = "wolfgangsee_water"
"l" = { entity = "gondel", to = [-8, 0] }
"C" = { entity = "checkpoint" }
"P" = { entity = "player_start" }
"G" = { entity = "goal" }

[map]
grid = '''
................................................................................................................
................................................................................................................
................................................................................................................
................................................................................................................
................................................................................................................
................................................................................................................
................................................................................................................
................................................................................................................
............................................###.................................................................
............................................###.................................................................
...P........................................###.........................C...............................G.......
#########################...----------------###-------#.........l..-------------...#############################
#########################~~~~~~~~~~~~~~~~~~~###~~~~~~~#............~~~~~~~~~~~~~xxx#############################
#########################~~~~~~~~~~~~~~~~~~~###~~~~~~~#............~~~~~~~~~~~~~xxx#############################
#########################~~~~~~~~~~~~~~~~~~~###~~~~~~~#############~~~~~~~~~~~~~xxx#############################
#########################~~~~~~~~~~~~~~~~~~~###~~~~~~~#############~~~~~~~~~~~~~xxx#############################
################################################################################################################
'''
