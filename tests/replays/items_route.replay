# Hand-written route through content/levels/00_items.level (grey box):
# Oblatenkiste, Mozartkugel (Zuckerschock), brick break, Oblaten,
# oblaten_10 brick (3 hits), Zaunerstollen (+1 life), checkpoint, jump over
# the Salzach pit, goal. The Selfie-Tourist walks left from the start (E3),
# turns at the wall and is stomped right after the jump over the wall
# (frame 675), so the player stays Zuckerschock to the goal.
# Score: 200 + 1000 + 50 + 100 + 5 * 200 + 3 * 200 = 2950; Oblaten 1 + 5 + 3 = 9.
level  = items
seed   = 1
source = handwritten
expect = complete frames=1270..1270 deaths=0 state=stage_clear
expect = oblaten>=9 score>=2950 lives=4 event=Stomped no_event=Died no_event=Hurt
